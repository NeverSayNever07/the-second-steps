# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase PostgreSQL, London region (eu-west-2), via the Session pooler (port 5432).
# Use the dedicated zayto_app user, not the postgres admin user (ADR-016 in docs/adr/).
# Encryption is configured in code using certs/supabase-ca.crt; do not add sslmode here.
DATABASE_URL="postgresql://zayto_app.PROJECT_REF:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# Prisma migrations use a separate login that owns database objects. The app
# must never receive this credential. Keep TLS verification enabled for Supabase.
MIGRATION_DATABASE_URL="postgresql://zayto_migrator.PROJECT_REF:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"
DATABASE_SSL_MODE="verify-full"

# Supabase Auth. All three are server-only: the browser never talks to Supabase (docs/ARCHITECTURE.md).
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"
SUPABASE_SECRET_KEY="sb_secret_REPLACE_ME"

# Who this deployment is for: "local" (your computer), "demo" (a hosted
# proof of concept) or "production" (real customers; sandbox sign-in off).
APP_ENV="local"

# Local proof-of-concept login. These addresses are treated as explicitly invited sandbox users.
SANDBOX_AUTH_EMAILS="owner@zayto.local,branch.manager@zayto.local,platform.owner@zayto.local,dual.owner@zayto.local,no.access@zayto.local"
# Development-only shortcut, off unless set to "true". Production hard-disables it.
SANDBOX_QUICK_SIGN_IN="true"
APP_URL="http://localhost:3000"
MAILPIT_API_URL="http://127.0.0.1:8025"

# Release safeguard. When true, staff MFA is forced on and cannot be weakened by a database flag.
REQUIRE_STAFF_MFA="false"
