# Copy to .env.docker and fill in real values. Never commit .env.docker.
# The values come from the project owner (not from the repository).

# Supabase database, runtime login only (never give the container the
# migration login). Encryption uses certs/supabase-ca.crt, which is in the image.
DATABASE_URL="postgresql://zayto_app.PROJECT_REF:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"
DATABASE_SSL_MODE="verify-full"

# Supabase Auth. The secret key stays on the server inside the container.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"
SUPABASE_SECRET_KEY="sb_secret_REPLACE_ME"

# Who this deployment is for. "demo" turns on the sandbox users and quick
# sign-in in this production build; "production" keeps them off whatever
# else is set (ADR-032).
APP_ENV="demo"

# The sandbox users and the quick sign-in shortcut.
SANDBOX_AUTH_EMAILS="owner@zayto.local,branch.manager@zayto.local,platform.owner@zayto.local,dual.owner@zayto.local,no.access@zayto.local"
SANDBOX_QUICK_SIGN_IN="true"

# The address people will use to open the app.
APP_URL="http://localhost:3000"

REQUIRE_STAFF_MFA="false"
