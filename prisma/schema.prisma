  epcRating         String?                     @map("epc_rating") @db.Char(1)
  epcEvidenceId     String?                     @map("epc_evidence_id") @db.Uuid
  epcEventOn        DateTime?                   @map("epc_event_on") @db.Date
  epcExpiresOn      DateTime?                   @map("epc_expires_on") @db.Date
  epcReference      String?                     @map("epc_reference") @db.VarChar(120)
  mediaFingerprint  String?                     @map("media_fingerprint") @db.VarChar(4000)
  actorMembershipId String                      @map("actor_membership_id") @db.Uuid
  recordedAt        DateTime                    @default(now()) @map("recorded_at") @db.Timestamptz(6)
  listing           Listing                     @relation(fields: [workspaceId, listingId], references: [workspaceId, id], onDelete: Restrict, map: "listing_events_listing_fkey")
  epcEvidence       PropertyComplianceEvidence? @relation(fields: [workspaceId, epcEvidenceId], references: [workspaceId, id], onDelete: Restrict, map: "listing_events_epc_evidence_fkey")
  actorMembership   Membership                  @relation(fields: [workspaceId, actorMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "listing_events_actor_fkey")

  @@unique([workspaceId, id])
  @@index([workspaceId, listingId, recordedAt(sort: Desc), id(sort: Desc)], map: "listing_events_latest_idx")
  @@index([workspaceId, actorMembershipId], map: "listing_events_actor_idx")
  @@index([workspaceId, epcEvidenceId], map: "listing_events_epc_evidence_idx")
  @@map("listing_events")
}

enum ListingMediaRole {
  PHOTO     @map("photo")
  FLOORPLAN @map("floorplan")

  @@map("listing_media_role")
}

/// A listing's photo or floorplan: order, caption and removal. The file is a
/// private document of kind listing_photo or listing_floorplan.
model ListingMedia {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId           String           @map("workspace_id") @db.Uuid
  listingId             String           @map("listing_id") @db.Uuid
  documentId            String           @map("document_id") @db.Uuid
  role                  ListingMediaRole
  position              Int
  caption               String           @default("") @db.VarChar(200)
  addedByMembershipId   String           @map("added_by_membership_id") @db.Uuid
  addedAt               DateTime         @default(now()) @map("added_at") @db.Timestamptz(6)
  removedAt             DateTime?        @map("removed_at") @db.Timestamptz(6)
  removedByMembershipId String?          @map("removed_by_membership_id") @db.Uuid
  removedReason         String?          @map("removed_reason") @db.VarChar(500)
  listing               Listing          @relation(fields: [workspaceId, listingId], references: [workspaceId, id], onDelete: Restrict, map: "listing_media_listing_fkey")
  document              Document         @relation(fields: [workspaceId, documentId], references: [workspaceId, id], onDelete: Restrict, map: "listing_media_document_fkey")
  addedByMembership     Membership       @relation("ListingMediaAddedBy", fields: [workspaceId, addedByMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "listing_media_added_by_fkey")
  removedByMembership   Membership?      @relation("ListingMediaRemovedBy", fields: [workspaceId, removedByMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "listing_media_removed_by_fkey")

  @@unique([workspaceId, id])
  @@unique([workspaceId, documentId], map: "listing_media_document_key")
  @@index([workspaceId, listingId, role, position, id], map: "listing_media_order_idx")
  @@index([workspaceId, addedByMembershipId], map: "listing_media_added_by_idx")
  @@index([workspaceId, removedByMembershipId], map: "listing_media_removed_by_idx")
  @@map("listing_media")
}

// A2 (ADR-036, ADR-037): applicants and property enquiries. Status and stage
// changes are backed by history rows written in the same transaction, and
// the database enforces the rules (see the migration).

enum ApplicantStatus {
  ACTIVE  @map("active")
  ON_HOLD @map("on_hold")
  CLOSED  @map("closed")

  @@map("applicant_status")
}

enum PropertyEnquiryStage {
  NEW              @map("new")
  CONTACTED        @map("contacted")
  VIEWING_ARRANGED @map("viewing_arranged")
  VIEWED           @map("viewed")
  CLOSED           @map("closed")

  @@map("property_enquiry_stage")
}

enum PropertyEnquiryChangeKind {
  STAFF             @map("staff")
  LISTING_WITHDRAWN @map("listing_withdrawn")

  @@map("property_enquiry_change_kind")
}

enum LettingsOutcomeKind {
  APPLICANT        @map("applicant")
  PROPERTY_ENQUIRY @map("property_enquiry")
  VIEWING          @map("viewing")

  @@map("lettings_outcome_kind")
}

model LettingsOutcomeReason {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId             String                @map("workspace_id") @db.Uuid
  name                    String                @db.VarChar(80)
  appliesTo               LettingsOutcomeKind   @map("applies_to")
  status                  EnquiryListItemStatus @default(ACTIVE)
  sortOrder               Int                   @default(0) @map("sort_order")
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace               Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  applicantsClosed        Applicant[]
  propertyEnquiriesClosed PropertyEnquiry[]

  @@unique([workspaceId, id])
  @@map("lettings_outcome_reasons")
}

/// One household looking to rent, led by one contact (ADR-036).
model Applicant {
  id                    String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId           String                        @map("workspace_id") @db.Uuid
  reference             String                        @db.VarChar(20)
  leadContactId         String                        @map("lead_contact_id") @db.Uuid
  responsibleBranchId   String                        @map("responsible_branch_id") @db.Uuid
  leadMembershipId      String?                       @map("lead_membership_id") @db.Uuid
  leadSourceId          String?                       @map("lead_source_id") @db.Uuid
  status                ApplicantStatus               @default(ACTIVE)
  statusChangedAt       DateTime                      @default(now()) @map("status_changed_at") @db.Timestamptz(6)
  closureReasonId       String?                       @map("closure_reason_id") @db.Uuid
  closureNote           String?                       @map("closure_note") @db.VarChar(500)
  createdByMembershipId String                        @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  leadContact           Contact                       @relation("ApplicantLeadContact", fields: [workspaceId, leadContactId], references: [workspaceId, id], onDelete: Restrict, map: "applicants_lead_contact_fkey")
  responsibleBranch     Branch                        @relation(fields: [workspaceId, responsibleBranchId], references: [workspaceId, id], onDelete: Restrict, map: "applicants_branch_fkey")
  leadMembership        Membership?                   @relation("ApplicantLeadStaff", fields: [workspaceId, leadMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "applicants_lead_membership_fkey")
  leadSource            LeadSource?                   @relation(fields: [workspaceId, leadSourceId], references: [workspaceId, id], onDelete: Restrict, map: "applicants_lead_source_fkey")
  closureReason         LettingsOutcomeReason?        @relation(fields: [workspaceId, closureReasonId], references: [workspaceId, id], onDelete: Restrict, map: "applicants_closure_reason_fkey")
  createdByMembership   Membership                    @relation("ApplicantCreatedBy", fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "applicants_created_by_fkey")
  statusHistory         ApplicantStatusHistory[]
  members               ApplicantMember[]
  requirementVersions   ApplicantRequirementVersion[]
  propertyEnquiries     PropertyEnquiry[]
  actions               Action[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, reference], map: "applicants_reference_key")
  @@index([workspaceId, responsibleBranchId, status], map: "applicants_branch_idx")
  @@index([workspaceId, leadMembershipId, status], map: "applicants_lead_membership_idx")
  @@index([workspaceId, leadSourceId], map: "applicants_lead_source_idx")
  @@index([workspaceId, closureReasonId], map: "applicants_closure_reason_idx")
  @@index([workspaceId, createdByMembershipId], map: "applicants_created_by_idx")
  @@map("applicants")
}

model ApplicantStatusHistory {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String          @map("workspace_id") @db.Uuid
  applicantId       String          @map("applicant_id") @db.Uuid
  fromStatus        ApplicantStatus @map("from_status")
  toStatus          ApplicantStatus @map("to_status")
  note              String?         @db.VarChar(500)
  actorMembershipId String          @map("actor_membership_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  applicant         Applicant       @relation(fields: [workspaceId, applicantId], references: [workspaceId, id], onDelete: Restrict, map: "applicant_status_history_applicant_fkey")
  actorMembership   Membership      @relation("ApplicantStatusChangedBy", fields: [workspaceId, actorMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "applicant_status_history_actor_fkey")

  @@unique([workspaceId, id])
  @@unique([workspaceId, applicantId, createdAt], map: "applicant_status_history_once_per_transaction")
  @@index([workspaceId, actorMembershipId], map: "applicant_status_history_actor_idx")
  @@map("applicant_status_history")
}

model ApplicantMember {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String      @map("workspace_id") @db.Uuid
  applicantId         String      @map("applicant_id") @db.Uuid
  contactId           String      @map("contact_id") @db.Uuid
  addedByMembershipId String      @map("added_by_membership_id") @db.Uuid
  addedAt             DateTime    @default(now()) @map("added_at") @db.Timestamptz(6)
  endedAt             DateTime?   @map("ended_at") @db.Timestamptz(6)
  endedByMembershipId String?     @map("ended_by_membership_id") @db.Uuid
  applicant           Applicant   @relation(fields: [workspaceId, applicantId], references: [workspaceId, id], onDelete: Restrict, map: "applicant_members_applicant_fkey")
  contact             Contact     @relation("ApplicantMemberContact", fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Restrict, map: "applicant_members_contact_fkey")
  addedByMembership   Membership  @relation("ApplicantMemberAddedBy", fields: [workspaceId, addedByMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "applicant_members_added_by_fkey")
  endedByMembership   Membership? @relation("ApplicantMemberEndedBy", fields: [workspaceId, endedByMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "applicant_members_ended_by_fkey")

  @@unique([workspaceId, id])
  @@index([workspaceId, contactId], map: "applicant_members_contact_idx")
  @@index([workspaceId, addedByMembershipId], map: "applicant_members_added_by_idx")
  @@index([workspaceId, endedByMembershipId], map: "applicant_members_ended_by_idx")
  @@map("applicant_members")
}

/// Append-only; the database numbers each version.
model ApplicantRequirementVersion {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId           String           @map("workspace_id") @db.Uuid
  applicantId           String           @map("applicant_id") @db.Uuid
  versionNo             Int              @default(0) @map("version_no")
  areas                 String[]         @default([]) @db.VarChar(60)
  minRentPence          Int?             @map("min_rent_pence")
  maxRentPence          Int?             @map("max_rent_pence")
  rentPeriod            RentPeriod       @default(MONTH) @map("rent_period")
  minBedrooms           Int?             @map("min_bedrooms") @db.SmallInt
  maxBedrooms           Int?             @map("max_bedrooms") @db.SmallInt
  propertyTypes         PropertyType[]   @default([]) @map("property_types")
  furnished             FurnishedStatus?
  moveFrom              DateTime?        @map("move_from") @db.Date
  moveBy                DateTime?        @map("move_by") @db.Date
  householdSize         Int?             @map("household_size") @db.SmallInt
  hasPets               Boolean          @default(false) @map("has_pets")
  notes                 String           @default("") @db.VarChar(500)
  createdByMembershipId String           @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  applicant             Applicant        @relation(fields: [workspaceId, applicantId], references: [workspaceId, id], onDelete: Restrict, map: "applicant_requirement_versions_applicant_fkey")
  createdByMembership   Membership       @relation("ApplicantRequirementCreatedBy", fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "applicant_requirement_versions_created_by_fkey")

  @@unique([workspaceId, id])
  @@unique([workspaceId, applicantId, versionNo], map: "applicant_requirement_versions_number_key")
  @@index([workspaceId, createdByMembershipId], map: "applicant_requirement_versions_created_by_idx")
  @@map("applicant_requirement_versions")
}

/// One applicant's interest in one listing; only on a Ready to advertise
/// listing (ADR-037).
model PropertyEnquiry {
  id                    String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId           String                        @map("workspace_id") @db.Uuid
  applicantId           String                        @map("applicant_id") @db.Uuid
  listingId             String                        @map("listing_id") @db.Uuid
  propertyId            String                        @map("property_id") @db.Uuid
  responsibleBranchId   String                        @map("responsible_branch_id") @db.Uuid
  stage                 PropertyEnquiryStage          @default(NEW)
  stageChangedAt        DateTime                      @default(now()) @map("stage_changed_at") @db.Timestamptz(6)
  assignedMembershipId  String?                       @map("assigned_membership_id") @db.Uuid
  leadSourceId          String?                       @map("lead_source_id") @db.Uuid
  closureReasonId       String?                       @map("closure_reason_id") @db.Uuid
  closureNote           String?                       @map("closure_note") @db.VarChar(500)
  closedByListing       Boolean                       @default(false) @map("closed_by_listing")
  createdByMembershipId String                        @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  applicant             Applicant                     @relation(fields: [workspaceId, applicantId], references: [workspaceId, id], onDelete: Restrict, map: "property_enquiries_applicant_fkey")
  listing               Listing                       @relation(fields: [workspaceId, listingId], references: [workspaceId, id], onDelete: Restrict, map: "property_enquiries_listing_fkey")
  property              Property                      @relation(fields: [workspaceId, propertyId], references: [workspaceId, id], onDelete: Restrict, map: "property_enquiries_property_fkey")
  responsibleBranch     Branch                        @relation(fields: [workspaceId, responsibleBranchId], references: [workspaceId, id], onDelete: Restrict, map: "property_enquiries_branch_fkey")
  assignedMembership    Membership?                   @relation("PropertyEnquiryAssigned", fields: [workspaceId, assignedMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "property_enquiries_assigned_fkey")
  leadSource            LeadSource?                   @relation(fields: [workspaceId, leadSourceId], references: [workspaceId, id], onDelete: Restrict, map: "property_enquiries_lead_source_fkey")
  closureReason         LettingsOutcomeReason?        @relation(fields: [workspaceId, closureReasonId], references: [workspaceId, id], onDelete: Restrict, map: "property_enquiries_closure_reason_fkey")
  createdByMembership   Membership                    @relation("PropertyEnquiryCreatedBy", fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "property_enquiries_created_by_fkey")
  stageHistory          PropertyEnquiryStageHistory[]
  actions               Action[]

  @@unique([workspaceId, id])
  @@index([workspaceId, listingId, stage], map: "property_enquiries_listing_idx")
  @@index([workspaceId, responsibleBranchId, stage], map: "property_enquiries_branch_idx")
  @@index([workspaceId, assignedMembershipId, stage], map: "property_enquiries_assigned_idx")
  @@index([workspaceId, propertyId], map: "property_enquiries_property_idx")
  @@index([workspaceId, leadSourceId], map: "property_enquiries_lead_source_idx")
  @@index([workspaceId, closureReasonId], map: "property_enquiries_closure_reason_idx")
  @@index([workspaceId, createdByMembershipId], map: "property_enquiries_created_by_idx")
  @@map("property_enquiries")
}

model PropertyEnquiryStageHistory {
  id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String                    @map("workspace_id") @db.Uuid
  propertyEnquiryId String                    @map("property_enquiry_id") @db.Uuid
  fromStage         PropertyEnquiryStage      @map("from_stage")
  toStage           PropertyEnquiryStage      @map("to_stage")
  kind              PropertyEnquiryChangeKind @default(STAFF)
  note              String?                   @db.VarChar(500)
  actorMembershipId String                    @map("actor_membership_id") @db.Uuid
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  propertyEnquiry   PropertyEnquiry           @relation(fields: [workspaceId, propertyEnquiryId], references: [workspaceId, id], onDelete: Restrict, map: "property_enquiry_stage_history_enquiry_fkey")
  actorMembership   Membership                @relation("PropertyEnquiryStageChangedBy", fields: [workspaceId, actorMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "property_enquiry_stage_history_actor_fkey")

  @@unique([workspaceId, id])
  @@unique([workspaceId, propertyEnquiryId, createdAt], map: "property_enquiry_stage_history_once_per_transaction")
  @@index([workspaceId, actorMembershipId], map: "property_enquiry_stage_history_actor_idx")
  @@map("property_enquiry_stage_history")
}
