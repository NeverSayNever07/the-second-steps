// One immutable file in the private documents bucket (C1). The row is written
// before the file is stored; only the status moves, one way. The object key
// is built in code from workspaceId, id and mediaType.
model Document {
  id                     String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId            String                      @map("workspace_id") @db.Uuid
  kind                   DocumentKind
  instructionId          String?                     @map("instruction_id") @db.Uuid
  propertyId             String?                     @map("property_id") @db.Uuid
  listingId              String?                     @map("listing_id") @db.Uuid
  displayName            String                      @map("display_name") @db.VarChar(120)
  mediaType              DocumentMedia               @map("media_type")
  byteSize               Int                         @map("byte_size")
  sha256                 String                      @db.Char(64)
  status                 DocumentStatus              @default(PENDING)
  failureCode            String?                     @map("failure_code") @db.VarChar(40)
  removalReason          String?                     @map("removal_reason") @db.VarChar(500)
  uploadedByMembershipId String                      @map("uploaded_by_membership_id") @db.Uuid
  removedByMembershipId  String?                     @map("removed_by_membership_id") @db.Uuid
  createdAt              DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  storedAt               DateTime?                   @map("stored_at") @db.Timestamptz(6)
  endedAt                DateTime?                   @map("ended_at") @db.Timestamptz(6)
  workspace              Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  instruction            Instruction?                @relation(fields: [workspaceId, instructionId], references: [workspaceId, id], onDelete: Restrict, map: "documents_instruction_fkey")
  property               Property?                   @relation(fields: [workspaceId, propertyId], references: [workspaceId, id], onDelete: Restrict, map: "documents_property_fkey")
  listing                Listing?                    @relation(fields: [workspaceId, listingId], references: [workspaceId, id], onDelete: Restrict, map: "documents_listing_fkey")
  uploadedByMembership   Membership                  @relation("DocumentUploadedBy", fields: [workspaceId, uploadedByMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "documents_uploaded_by_fkey")
  removedByMembership    Membership?                 @relation("DocumentRemovedBy", fields: [workspaceId, removedByMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "documents_removed_by_fkey")
  agreement              InstructionAgreement?
  complianceEvidence     PropertyComplianceEvidence?
  listingMedia           ListingMedia?

  @@unique([workspaceId, id])
  @@index([workspaceId, instructionId], map: "documents_instruction_idx")
  @@index([workspaceId, propertyId], map: "documents_property_idx")
  @@index([workspaceId, listingId], map: "documents_listing_idx")
  @@index([workspaceId, status, createdAt], map: "documents_status_idx")
  @@index([workspaceId, uploadedByMembershipId], map: "documents_uploaded_by_idx")
  @@index([workspaceId, removedByMembershipId], map: "documents_removed_by_idx")
  @@map("documents")
}

// One uploaded agreement PDF for an instruction (C2). The database sets what
// it covers (terms version, material fingerprint, signatories) when the row
// is inserted, so the app inserts drafts with a raw query that leaves those
// columns out. One draft per instruction and supersession once are partial
// unique indexes in the migration.
model InstructionAgreement {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId             String                    @map("workspace_id") @db.Uuid
  instructionId           String                    @map("instruction_id") @db.Uuid
  documentId              String                    @map("document_id") @db.Uuid
  termsVersionId          String                    @map("terms_version_id") @db.Uuid
  materialFingerprint     String                    @map("material_fingerprint") @db.Char(64)
  signatoryContactIds     String[]                  @map("signatory_contact_ids") @db.Uuid
  state                   InstructionAgreementState @default(DRAFT)
  signedOn                DateTime?                 @map("signed_on") @db.Date
  completedByMembershipId String?                   @map("completed_by_membership_id") @db.Uuid
  completedAt             DateTime?                 @map("completed_at") @db.Timestamptz(6)
  supersedesAgreementId   String?                   @map("supersedes_agreement_id") @db.Uuid
  discardedByMembershipId String?                   @map("discarded_by_membership_id") @db.Uuid
  discardedAt             DateTime?                 @map("discarded_at") @db.Timestamptz(6)
  discardReason           String?                   @map("discard_reason") @db.VarChar(500)
  createdByMembershipId   String                    @map("created_by_membership_id") @db.Uuid
  createdAt               DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  instruction             Instruction               @relation(fields: [workspaceId, instructionId], references: [workspaceId, id], onDelete: Restrict, map: "instruction_agreements_instruction_fkey")
  document                Document                  @relation(fields: [workspaceId, documentId], references: [workspaceId, id], onDelete: Restrict, map: "instruction_agreements_document_fkey")
  termsVersion            InstructionTermsVersion   @relation(fields: [workspaceId, termsVersionId], references: [workspaceId, id], onDelete: Restrict, map: "instruction_agreements_terms_fkey")
  supersedes              InstructionAgreement?     @relation("InstructionAgreementSupersedes", fields: [workspaceId, supersedesAgreementId], references: [workspaceId, id], onDelete: Restrict, map: "instruction_agreements_supersedes_fkey")
  supersededBy            InstructionAgreement[]    @relation("InstructionAgreementSupersedes")
  createdByMembership     Membership                @relation("InstructionAgreementCreatedBy", fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "instruction_agreements_created_by_fkey")
  completedByMembership   Membership?               @relation("InstructionAgreementCompletedBy", fields: [workspaceId, completedByMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "instruction_agreements_completed_by_fkey")
  discardedByMembership   Membership?               @relation("InstructionAgreementDiscardedBy", fields: [workspaceId, discardedByMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "instruction_agreements_discarded_by_fkey")

  @@unique([workspaceId, id])
  @@unique([workspaceId, documentId], map: "instruction_agreements_document_key")
  @@index([workspaceId, instructionId], map: "instruction_agreements_instruction_idx")
  @@index([workspaceId, termsVersionId], map: "instruction_agreements_terms_idx")
  @@index([workspaceId, createdByMembershipId], map: "instruction_agreements_created_by_idx")
  @@index([workspaceId, completedByMembershipId], map: "instruction_agreements_completed_by_idx")
  @@index([workspaceId, discardedByMembershipId], map: "instruction_agreements_discarded_by_idx")
  @@map("instruction_agreements")
}

