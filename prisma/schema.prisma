// Database structure. Add tables only for the slice being built (database.mdc).
// The connection address lives in prisma.config.ts, not here (Prisma 7).

generator client {
  provider = "prisma-client"
  output   = "../core/db/generated"
}

datasource db {
  provider = "postgresql"
}

enum IdentityStatus {
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")

  @@map("identity_status")
}

enum AuthenticationProvider {
  SUPABASE @map("supabase")

  @@map("authentication_provider")
}

enum WorkspaceType {
  AGENCY            @map("agency")
  LANDLORD          @map("landlord")
  PLATFORM_INTERNAL @map("platform_internal")

  @@map("workspace_type")
}

enum WorkspaceStatus {
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  CLOSED    @map("closed")

  @@map("workspace_status")
}

enum BranchStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")

  @@map("branch_status")
}

enum MembershipStatus {
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  ENDED     @map("ended")

  @@map("membership_status")
}

enum MembershipScopeMode {
  WORKSPACE      @map("workspace")
  NAMED_BRANCHES @map("named_branches")

  @@map("membership_scope_mode")
}

enum MembershipRoleCode {
  WORKSPACE_OWNER  @map("workspace_owner")
  AGENCY_ADMIN     @map("agency_admin")
  BRANCH_MANAGER   @map("branch_manager")
  NEGOTIATOR       @map("negotiator")
  PROPERTY_MANAGER @map("property_manager")
  ACCOUNTS         @map("accounts")
  READ_ONLY        @map("read_only")

  @@map("membership_role_code")
}

enum PlatformRoleCode {
  PLATFORM_OWNER @map("platform_owner")

  @@map("platform_role_code")
}

enum PlatformRoleStatus {
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  ENDED     @map("ended")

  @@map("platform_role_status")
}

enum AuditOutcome {
  SUCCEEDED @map("succeeded")
  DENIED    @map("denied")
  FAILED    @map("failed")

  @@map("audit_outcome")
}

enum FeatureFlagStatus {
  ACTIVE  @map("active")
  RETIRED @map("retired")

  @@map("feature_flag_status")
}

enum ContactKind {
  PERSON       @map("person")
  ORGANISATION @map("organisation")

  @@map("contact_kind")
}

enum ContactStatus {
  ACTIVE   @map("active")
  ARCHIVED @map("archived")
  MERGED   @map("merged")

  @@map("contact_status")
}

enum ContactNoteVisibility {
  BRANCH @map("branch")
  AGENCY @map("agency")

  @@map("contact_note_visibility")
}

enum ContactNoteStatus {
  ACTIVE @map("active")
  VOIDED @map("voided")

  @@map("contact_note_status")
}

enum OrganisationType {
  LIMITED_COMPANY @map("limited_company")
  LLP             @map("llp")
  PARTNERSHIP     @map("partnership")
  TRUST           @map("trust")
  CHARITY         @map("charity")
  OTHER           @map("other")

  @@map("organisation_type")
}

enum ContactPointKind {
  EMAIL     @map("email")
  TELEPHONE @map("telephone")

  @@map("contact_point_kind")
}

enum CommunicationChannel {
  EMAIL     @map("email")
  TELEPHONE @map("telephone")
  SMS       @map("sms")
  WHATSAPP  @map("whatsapp")
  POST      @map("post")

  @@map("communication_channel")
}

enum ContactAddressKind {
  INDIVIDUAL     @map("individual")
  REGISTERED     @map("registered")
  CORRESPONDENCE @map("correspondence")

  @@map("contact_address_kind")
}

enum PropertyStatus {
  ACTIVE   @map("active")
  ARCHIVED @map("archived")

  @@map("property_status")
}

enum PropertyType {
  DETACHED      @map("detached")
  SEMI_DETACHED @map("semi_detached")
  TERRACED      @map("terraced")
  BUNGALOW      @map("bungalow")
  FLAT          @map("flat")
  MAISONETTE    @map("maisonette")
  ROOM          @map("room")
  OTHER         @map("other")

  @@map("property_type")
}

enum FurnishedStatus {
  FURNISHED      @map("furnished")
  PART_FURNISHED @map("part_furnished")
  UNFURNISHED    @map("unfurnished")
  FLEXIBLE       @map("flexible")

  @@map("furnished_status")
}

enum FloorAreaUnit {
  SQ_FT @map("sq_ft")
  SQ_M  @map("sq_m")

  @@map("floor_area_unit")
}

enum CouncilTaxBand {
  A @map("A")
  B @map("B")
  C @map("C")
  D @map("D")
  E @map("E")
  F @map("F")
  G @map("G")
  H @map("H")

  @@map("council_tax_band")
}

enum PropertyFeature {
  PRIVATE_GARDEN        @map("private_garden")
  COMMUNAL_GARDEN       @map("communal_garden")
  BALCONY               @map("balcony")
  TERRACE               @map("terrace")
  PATIO                 @map("patio")
  OFF_STREET_PARKING    @map("off_street_parking")
  ALLOCATED_PARKING     @map("allocated_parking")
  GARAGE                @map("garage")
  ON_STREET_PARKING     @map("on_street_parking")
  PERMIT_PARKING        @map("permit_parking")
  EV_CHARGING           @map("ev_charging")
  LIFT                  @map("lift")
  CONCIERGE             @map("concierge")
  BIKE_STORAGE          @map("bike_storage")
  WHEELCHAIR_ACCESSIBLE @map("wheelchair_accessible")
  GAS_CENTRAL_HEATING   @map("gas_central_heating")
  ELECTRIC_HEATING      @map("electric_heating")
  UNDERFLOOR_HEATING    @map("underfloor_heating")
  EN_SUITE              @map("en_suite")
  UTILITY_ROOM          @map("utility_room")
  DISHWASHER            @map("dishwasher")
  WASHING_MACHINE       @map("washing_machine")
  FIREPLACE             @map("fireplace")

  @@map("property_feature")
}

enum PropertyNoteStatus {
  ACTIVE @map("active")
  VOIDED @map("voided")

  @@map("property_note_status")
}

enum EnquiryStage {
  NEW_ENQUIRY         @map("new_enquiry")
  APPRAISAL_BOOKED    @map("appraisal_booked")
  APPRAISAL_COMPLETED @map("appraisal_completed")
  WON                 @map("won")
  LOST                @map("lost")
  POSTPONED           @map("postponed")

  @@map("enquiry_stage")
}

enum EnquiryListItemStatus {
  ACTIVE @map("active")
  HIDDEN @map("hidden")

  @@map("enquiry_list_item_status")
}

enum EnquiryOutcomeKind {
  LOST      @map("lost")
  POSTPONED @map("postponed")
  BOTH      @map("both")

  @@map("enquiry_outcome_kind")
}

enum AppraisalStatus {
  SCHEDULED      @map("scheduled")
  COMPLETED      @map("completed")
  CANCELLED      @map("cancelled")
  DID_NOT_ATTEND @map("did_not_attend")

  @@map("appraisal_status")
}

enum LettingServiceType {
  LET_ONLY        @map("let_only")
  RENT_COLLECTION @map("rent_collection")
  FULLY_MANAGED   @map("fully_managed")

  @@map("letting_service_type")
}

enum FeeKind {
  PERCENTAGE @map("percentage")
  FIXED      @map("fixed")

  @@map("fee_kind")
}

enum VatTreatment {
  INCLUSIVE @map("inclusive")
  EXCLUSIVE @map("exclusive")

  @@map("vat_treatment")
}

enum EnquiryTaskStatus {
  OPEN      @map("open")
  DONE      @map("done")
  CANCELLED @map("cancelled")

  @@map("enquiry_task_status")
}

enum ActionKind {
  CALL  @map("call")
  EMAIL @map("email")
  SEND  @map("send")
  CHASE @map("chase")
  OTHER @map("other")

  @@map("action_kind")
}

enum ActionStatus {
  OPEN      @map("open")
  DONE      @map("done")
  CANCELLED @map("cancelled")

  @@map("action_status")
}

enum InstructionJourneyStage {
  ONBOARDING      @map("onboarding")
  READY_TO_MARKET @map("ready_to_market")
  WITHDRAWN       @map("withdrawn")

  @@map("instruction_journey_stage")
}

enum RentPeriod {
  MONTH @map("month")
  WEEK  @map("week")

  @@map("rent_period")
}

enum FeeFrequency {
  ONE_OFF  @map("one_off")
  WEEKLY   @map("weekly")
  MONTHLY  @map("monthly")
  ANNUALLY @map("annually")

  @@map("fee_frequency")
}

enum FeeVatTreatment {
  INCLUSIVE @map("inclusive")
  EXCLUSIVE @map("exclusive")
  NONE      @map("none")

  @@map("fee_vat_treatment")
}

enum DepositOffering {
  STANDARD    @map("standard")
  REPLACEMENT @map("replacement")
  BOTH        @map("both")

  @@map("deposit_offering")
}

enum InstructionAgreementStatus {
  PREPARED @map("prepared")
  SENT     @map("sent")
  SIGNED   @map("signed")

  @@map("instruction_agreement_status")
}

enum InstructionOwnershipCheckStatus {
  IN_PROGRESS  @map("in_progress")
  VERIFIED     @map("verified")
  NOT_VERIFIED @map("not_verified")

  @@map("instruction_ownership_check_status")
}

enum InstructionExceptionKind {
  AGREEMENT       @map("agreement")
  OWNERSHIP_CHECK @map("ownership_check")

  @@map("instruction_exception_kind")
}

enum InstructionAgreementState {
  DRAFT     @map("draft")
  COMPLETED @map("completed")
  DISCARDED @map("discarded")

  @@map("instruction_agreement_state")
}

enum DocumentKind {
  INSTRUCTION_AGREEMENT @map("instruction_agreement")
  COMPLIANCE_EVIDENCE   @map("compliance_evidence")
  LISTING_PHOTO         @map("listing_photo")
  LISTING_FLOORPLAN     @map("listing_floorplan")

  @@map("document_kind")
}

enum DocumentMedia {
  PDF  @map("pdf")
  JPEG @map("jpeg")
  PNG  @map("png")

  @@map("document_media")
}

enum DocumentStatus {
  PENDING @map("pending")
  STORED  @map("stored")
  FAILED  @map("failed")
  REMOVED @map("removed")

  @@map("document_status")
}

model UserIdentity {
  id                      String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName               String?                        @map("first_name") @db.VarChar(100)
  lastName                String?                        @map("last_name") @db.VarChar(100)
  primaryEmail            String?                        @map("primary_email") @db.VarChar(254)
  status                  IdentityStatus                 @default(ACTIVE)
  createdAt               DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  providerLinks           AuthenticationProviderLink[]
  memberships             Membership[]
  platformRoles           PlatformRoleAssignment[]       @relation("PlatformRoleUser")
  platformRolesAssigned   PlatformRoleAssignment[]       @relation("PlatformRoleAssignedBy")
  membershipRolesAssigned MembershipRole[]               @relation("MembershipRoleAssignedBy")
  branchAccessAssigned    MembershipBranchAccess[]       @relation("BranchAccessAssignedBy")
  auditEvents             AuditEvent[]                   @relation("AuditActor")
  featureFlagChanges      WorkspaceFeatureFlagOverride[] @relation("FeatureFlagChangedBy")

  @@index([firstName])
  @@index([lastName])
  @@index([primaryEmail])
  @@map("user_identities")
}

model AuthenticationProviderLink {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userIdentityId  String                 @map("user_identity_id") @db.Uuid
  provider        AuthenticationProvider
  providerSubject String                 @map("provider_subject") @db.Uuid
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  userIdentity    UserIdentity           @relation(fields: [userIdentityId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userIdentityId])
  @@map("authentication_provider_links")
}

model Workspace {
  id                   String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                 String                         @unique @db.VarChar(63)
  displayName          String                         @map("display_name") @db.VarChar(160)
  legalName            String?                        @map("legal_name") @db.VarChar(160)
  companyNumber        String?                        @map("company_number") @db.VarChar(8)
  primaryEmail         String?                        @map("primary_email") @db.VarChar(254)
  telephone            String?                        @db.VarChar(32)
  website              String?                        @db.VarChar(2048)
  registeredAddress1   String?                        @map("registered_address_1") @db.VarChar(160)
  registeredAddress2   String?                        @map("registered_address_2") @db.VarChar(160)
  registeredTownCity   String?                        @map("registered_town_city") @db.VarChar(100)
  registeredCounty     String?                        @map("registered_county") @db.VarChar(100)
  registeredPostcode   String?                        @map("registered_postcode") @db.VarChar(16)
  type                 WorkspaceType
  status               WorkspaceStatus                @default(ACTIVE)
  createdAt            DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  branches             Branch[]
  memberships          Membership[]
  auditEvents          AuditEvent[]
  featureFlagOverrides WorkspaceFeatureFlagOverride[]
  contacts             Contact[]
  contactNotes         ContactNote[]
  properties           Property[]
  leadSources          LeadSource[]
  outcomeReasons       EnquiryOutcomeReason[]
  enquiries            Enquiry[]
  actions              Action[]
  instructions         Instruction[]
  documents            Document[]

  lettingsOutcomeReasons LettingsOutcomeReason[]

  @@map("workspaces")
}

model Branch {
  id           String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String                   @map("workspace_id") @db.Uuid
  name         String                   @db.VarChar(160)
  email        String?                  @db.VarChar(254)
  telephone    String?                  @db.VarChar(32)
  address1     String?                  @map("address_1") @db.VarChar(160)
  address2     String?                  @map("address_2") @db.VarChar(160)
  townCity     String?                  @map("town_city") @db.VarChar(100)
  county       String?                  @db.VarChar(100)
  postcode     String?                  @db.VarChar(16)
  status       BranchStatus             @default(ACTIVE)
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace    Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  access       MembershipBranchAccess[]
  contactLinks ContactBranchLink[]
  contactNotes ContactNote[]
  properties   Property[]
  transfersOut PropertyBranchTransfer[] @relation("PropertyTransferFrom")
  transfersIn  PropertyBranchTransfer[] @relation("PropertyTransferTo")
  enquiries    Enquiry[]
  actions      Action[]
  instructions Instruction[]

  applicants        Applicant[]
  propertyEnquiries PropertyEnquiry[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, name])
  @@index([workspaceId, status])
  @@map("branches")
}

model Membership {
  id                         String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId                String                          @map("workspace_id") @db.Uuid
  userIdentityId             String                          @map("user_identity_id") @db.Uuid
  status                     MembershipStatus                @default(ACTIVE)
  scopeMode                  MembershipScopeMode             @map("scope_mode")
  startedAt                  DateTime                        @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt                    DateTime?                       @map("ended_at") @db.Timestamptz(6)
  createdAt                  DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace                  Workspace                       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  userIdentity               UserIdentity                    @relation(fields: [userIdentityId], references: [id], onDelete: Restrict)
  roles                      MembershipRole[]
  branchAccess               MembershipBranchAccess[]
  auditEvents                AuditEvent[]                    @relation("AuditMembership")
  contactsCreated            Contact[]                       @relation("ContactCreatedBy")
  contactBranchLinksCreated  ContactBranchLink[]             @relation("ContactBranchLinkCreatedBy")
  contactNotesCreated        ContactNote[]                   @relation("ContactNoteCreatedBy")
  contactNotesVoided         ContactNote[]                   @relation("ContactNoteVoidedBy")
  contactNoteRevisions       ContactNoteRevision[]           @relation("ContactNoteEditedBy")
  propertiesCreated          Property[]                      @relation("PropertyCreatedBy")
  propertyTransfers          PropertyBranchTransfer[]        @relation("PropertyTransferredBy")
  propertyOwnershipsCreated  PropertyOwnership[]             @relation("PropertyOwnershipCreatedBy")
  propertyNotesCreated       PropertyNote[]                  @relation("PropertyNoteCreatedBy")
  propertyNotesVoided        PropertyNote[]                  @relation("PropertyNoteVoidedBy")
  propertyNoteRevisions      PropertyNoteRevision[]          @relation("PropertyNoteEditedBy")
  enquiriesCreated           Enquiry[]                       @relation("EnquiryCreatedBy")
  enquiriesLed               Enquiry[]                       @relation("EnquiryLead")
  enquiryStageChanges        EnquiryStageHistory[]           @relation("EnquiryStageChangedBy")
  appraisalsAssigned         Appraisal[]                     @relation("AppraisalAssigned")
  appraisalsCreated          Appraisal[]                     @relation("AppraisalCreatedBy")
  enquiryTasksAssigned       EnquiryTask[]                   @relation("EnquiryTaskAssigned")
  enquiryTasksClosed         EnquiryTask[]                   @relation("EnquiryTaskClosedBy")
  enquiryTasksCreated        EnquiryTask[]                   @relation("EnquiryTaskCreatedBy")
  actionsAssigned            Action[]                        @relation("ActionAssigned")
  actionsClosed              Action[]                        @relation("ActionClosedBy")
  actionsCreated             Action[]                        @relation("ActionCreatedBy")
  actionsHandedOver          Action[]                        @relation("ActionHandedOverBy")
  instructionsLed            Instruction[]                   @relation("InstructionLead")
  instructionsEnded          Instruction[]                   @relation("InstructionEndedBy")
  instructionsCreated        Instruction[]                   @relation("InstructionCreatedBy")
  instructionJourneyChanges  InstructionJourneyHistory[]     @relation("InstructionJourneyChangedBy")
  instructionPartiesAdded    InstructionParty[]              @relation("InstructionPartyAddedBy")
  instructionPartiesRemoved  InstructionParty[]              @relation("InstructionPartyRemovedBy")
  instructionTermsCreated    InstructionTermsVersion[]       @relation("InstructionTermsCreatedBy")
  instructionAgreementEvents InstructionAgreementEvent[]     @relation("InstructionAgreementRecordedBy")
  instructionOwnershipChecks InstructionOwnershipCheck[]     @relation("InstructionOwnershipRecordedBy")
  instructionExceptions      InstructionException[]          @relation("InstructionExceptionApprovedBy")
  documentsUploaded          Document[]                      @relation("DocumentUploadedBy")
  documentsRemoved           Document[]                      @relation("DocumentRemovedBy")
  agreementsCreated          InstructionAgreement[]          @relation("InstructionAgreementCreatedBy")
  agreementsCompleted        InstructionAgreement[]          @relation("InstructionAgreementCompletedBy")
  agreementsDiscarded        InstructionAgreement[]          @relation("InstructionAgreementDiscardedBy")
  complianceItemsCreated     PropertyComplianceItem[]
  complianceAssessments      PropertyComplianceAssessment[]
  complianceEvidence         PropertyComplianceEvidence[]
  complianceStatusEvents     PropertyComplianceStatusEvent[]

  listingsCreated        Listing[]
  listingVersionsCreated ListingContentVersion[]
  listingEvents          ListingEvent[]

  listingMediaAdded   ListingMedia[] @relation("ListingMediaAddedBy")
  listingMediaRemoved ListingMedia[] @relation("ListingMediaRemovedBy")

  applicantsLed                Applicant[]                   @relation("ApplicantLeadStaff")
  applicantsCreated            Applicant[]                   @relation("ApplicantCreatedBy")
  applicantStatusChanges       ApplicantStatusHistory[]      @relation("ApplicantStatusChangedBy")
  applicantMembersAdded        ApplicantMember[]             @relation("ApplicantMemberAddedBy")
  applicantMembersEnded        ApplicantMember[]             @relation("ApplicantMemberEndedBy")
  applicantRequirementVersions ApplicantRequirementVersion[] @relation("ApplicantRequirementCreatedBy")
  propertyEnquiriesAssigned    PropertyEnquiry[]             @relation("PropertyEnquiryAssigned")
  propertyEnquiriesCreated     PropertyEnquiry[]             @relation("PropertyEnquiryCreatedBy")
  propertyEnquiryStageChanges  PropertyEnquiryStageHistory[] @relation("PropertyEnquiryStageChangedBy")

  @@unique([workspaceId, userIdentityId])
  @@unique([workspaceId, id])
  @@index([userIdentityId, status])
  @@index([workspaceId, status])
  @@map("memberships")
}

model MembershipRole {
  id                       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId              String             @map("workspace_id") @db.Uuid
  membershipId             String             @map("membership_id") @db.Uuid
  roleCode                 MembershipRoleCode @map("role_code")
  assignedByUserIdentityId String?            @map("assigned_by_user_identity_id") @db.Uuid
  assignedAt               DateTime           @default(now()) @map("assigned_at") @db.Timestamptz(6)
  membership               Membership         @relation(fields: [workspaceId, membershipId], references: [workspaceId, id], onDelete: Cascade)
  assignedBy               UserIdentity?      @relation("MembershipRoleAssignedBy", fields: [assignedByUserIdentityId], references: [id], onDelete: SetNull)

  @@unique([membershipId, roleCode])
  @@index([workspaceId, roleCode])
  @@index([assignedByUserIdentityId])
  @@map("membership_roles")
}

model MembershipBranchAccess {
  id                       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId              String        @map("workspace_id") @db.Uuid
  membershipId             String        @map("membership_id") @db.Uuid
  branchId                 String        @map("branch_id") @db.Uuid
  assignedByUserIdentityId String?       @map("assigned_by_user_identity_id") @db.Uuid
  assignedAt               DateTime      @default(now()) @map("assigned_at") @db.Timestamptz(6)
  membership               Membership    @relation(fields: [workspaceId, membershipId], references: [workspaceId, id], onDelete: Cascade)
  branch                   Branch        @relation(fields: [workspaceId, branchId], references: [workspaceId, id], onDelete: Cascade)
  assignedBy               UserIdentity? @relation("BranchAccessAssignedBy", fields: [assignedByUserIdentityId], references: [id], onDelete: SetNull)

  @@unique([membershipId, branchId])
  @@index([workspaceId, branchId])
  @@index([assignedByUserIdentityId])
  @@map("membership_branch_access")
}

model PlatformRoleAssignment {
  id                       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userIdentityId           String             @map("user_identity_id") @db.Uuid
  roleCode                 PlatformRoleCode   @map("role_code")
  status                   PlatformRoleStatus @default(ACTIVE)
  assignedByUserIdentityId String?            @map("assigned_by_user_identity_id") @db.Uuid
  assignedAt               DateTime           @default(now()) @map("assigned_at") @db.Timestamptz(6)
  endedAt                  DateTime?          @map("ended_at") @db.Timestamptz(6)
  userIdentity             UserIdentity       @relation("PlatformRoleUser", fields: [userIdentityId], references: [id], onDelete: Restrict)
  assignedBy               UserIdentity?      @relation("PlatformRoleAssignedBy", fields: [assignedByUserIdentityId], references: [id], onDelete: SetNull)

  @@unique([userIdentityId, roleCode])
  @@index([status, roleCode])
  @@index([assignedByUserIdentityId])
  @@map("platform_role_assignments")
}

model AuditEvent {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String?       @map("workspace_id") @db.Uuid
  actorUserIdentityId String?       @map("actor_user_identity_id") @db.Uuid
  actorMembershipId   String?       @map("actor_membership_id") @db.Uuid
  action              String        @db.VarChar(120)
  outcome             AuditOutcome
  targetType          String?       @map("target_type") @db.VarChar(80)
  targetId            String?       @map("target_id") @db.VarChar(160)
  requestId           String        @map("request_id") @db.VarChar(160)
  metadata            Json?
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace           Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actorUserIdentity   UserIdentity? @relation("AuditActor", fields: [actorUserIdentityId], references: [id], onDelete: SetNull)
  actorMembership     Membership?   @relation("AuditMembership", fields: [workspaceId, actorMembershipId], references: [workspaceId, id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([actorUserIdentityId, createdAt])
  @@index([actorMembershipId])
  @@index([action, createdAt])
  @@map("audit_events")
}

model FeatureFlag {
  id                 String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                String                         @unique @db.VarChar(80)
  displayName        String                         @map("display_name") @db.VarChar(160)
  description        String                         @db.VarChar(500)
  globalEnabled      Boolean                        @default(false) @map("global_enabled")
  zaytoUsersEnabled  Boolean                        @default(false) @map("zayto_users_enabled")
  status             FeatureFlagStatus              @default(ACTIVE)
  createdAt          DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspaceOverrides WorkspaceFeatureFlagOverride[]

