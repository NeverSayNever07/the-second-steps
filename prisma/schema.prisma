model Enquiry {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId           String                @map("workspace_id") @db.Uuid
  reference             String                @db.VarChar(20)
  responsibleBranchId   String                @map("responsible_branch_id") @db.Uuid
  stage                 EnquiryStage          @default(NEW_ENQUIRY)
  enquirerName          String                @map("enquirer_name") @db.VarChar(200)
  enquirerEmail         String?               @map("enquirer_email") @db.VarChar(254)
  enquirerTelephone     String?               @map("enquirer_telephone") @db.VarChar(32)
  addressBuilding       String?               @map("address_building") @db.VarChar(160)
  addressStreet         String?               @map("address_street") @db.VarChar(160)
  postcode              String?               @db.VarChar(8)
  contactId             String?               @map("contact_id") @db.Uuid
  propertyId            String?               @map("property_id") @db.Uuid
  leadSourceId          String?               @map("lead_source_id") @db.Uuid
  leadMembershipId      String?               @map("lead_membership_id") @db.Uuid
  outcomeReasonId       String?               @map("outcome_reason_id") @db.Uuid
  outcomeNote           String?               @map("outcome_note") @db.VarChar(500)
  followUpOn            DateTime?             @map("follow_up_on") @db.Date
  summary               String?               @db.VarChar(2000)
  // Set by a database trigger whenever the stage changes.
  stageChangedAt        DateTime              @default(now()) @map("stage_changed_at") @db.Timestamptz(6)
  createdByMembershipId String                @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace             Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  responsibleBranch     Branch                @relation(fields: [workspaceId, responsibleBranchId], references: [workspaceId, id], onDelete: Restrict, map: "landlord_enquiries_branch_fkey")
  contact               Contact?              @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Restrict, map: "landlord_enquiries_contact_fkey")
  property              Property?             @relation(fields: [workspaceId, propertyId], references: [workspaceId, id], onDelete: Restrict, map: "landlord_enquiries_property_fkey")
  leadSource            LeadSource?           @relation(fields: [workspaceId, leadSourceId], references: [workspaceId, id], onDelete: Restrict, map: "landlord_enquiries_lead_source_fkey")
  leadMembership        Membership?           @relation("EnquiryLead", fields: [workspaceId, leadMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "landlord_enquiries_lead_membership_fkey")
  outcomeReason         EnquiryOutcomeReason? @relation(fields: [workspaceId, outcomeReasonId], references: [workspaceId, id], onDelete: Restrict, map: "landlord_enquiries_outcome_reason_fkey")
  createdByMembership   Membership            @relation("EnquiryCreatedBy", fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "landlord_enquiries_created_by_fkey")
  stageHistory          EnquiryStageHistory[]
  appraisals            Appraisal[]
  tasks                 EnquiryTask[]
  instruction           Instruction?

  @@unique([workspaceId, id])
  @@unique([workspaceId, reference])
  @@index([workspaceId, responsibleBranchId, stage], map: "landlord_enquiries_branch_stage_idx")
  @@index([workspaceId, stage, updatedAt(sort: Desc)], map: "landlord_enquiries_stage_updated_idx")
  @@index([workspaceId, contactId], map: "landlord_enquiries_contact_idx")
  @@index([workspaceId, propertyId], map: "landlord_enquiries_property_idx")
  @@index([workspaceId, postcode], map: "landlord_enquiries_postcode_idx")
  @@index([workspaceId, leadMembershipId], map: "landlord_enquiries_lead_membership_idx")
  @@index([workspaceId, leadSourceId], map: "landlord_enquiries_lead_source_idx")
  @@index([workspaceId, outcomeReasonId], map: "landlord_enquiries_outcome_reason_idx")
  @@index([workspaceId, createdByMembershipId], map: "landlord_enquiries_creator_idx")
  @@map("landlord_enquiries")
}

model EnquiryStageHistory {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId           String       @map("workspace_id") @db.Uuid
  enquiryId             String       @map("enquiry_id") @db.Uuid
  fromStage             EnquiryStage @map("from_stage")
  toStage               EnquiryStage @map("to_stage")
  reason                String?      @db.VarChar(500)
  changedByMembershipId String       @map("changed_by_membership_id") @db.Uuid
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  enquiry               Enquiry      @relation(fields: [workspaceId, enquiryId], references: [workspaceId, id], onDelete: Restrict, map: "enquiry_stage_history_enquiry_fkey")
  changedByMembership   Membership   @relation("EnquiryStageChangedBy", fields: [workspaceId, changedByMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "enquiry_stage_history_actor_fkey")

  @@unique([workspaceId, id])
  @@unique([workspaceId, enquiryId, createdAt], map: "enquiry_stage_history_one_per_transaction")
  @@index([workspaceId, changedByMembershipId], map: "enquiry_stage_history_actor_idx")
  @@map("enquiry_stage_history")
}

model Appraisal {
  id                       String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId              String              @map("workspace_id") @db.Uuid
  enquiryId                String              @map("enquiry_id") @db.Uuid
  scheduledAt              DateTime            @map("scheduled_at") @db.Timestamptz(6)
  assignedMembershipId     String              @map("assigned_membership_id") @db.Uuid
  status                   AppraisalStatus     @default(SCHEDULED)
  expectedMonthlyRentPence Int?                @map("expected_monthly_rent_pence")
  recommendedService       LettingServiceType? @map("recommended_service")
  feeKind                  FeeKind?            @map("fee_kind")
  // Basis points for a percentage fee (1250 = 12.5%); pence for a fixed fee.
  feeValue                 Int?                @map("fee_value")
  feeVat                   VatTreatment?       @map("fee_vat")
  bookingNotes             String?             @map("booking_notes") @db.VarChar(2000)
  notes                    String?             @db.VarChar(2000)
  completedAt              DateTime?           @map("completed_at") @db.Timestamptz(6)
  createdByMembershipId    String              @map("created_by_membership_id") @db.Uuid
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  enquiry                  Enquiry             @relation(fields: [workspaceId, enquiryId], references: [workspaceId, id], onDelete: Restrict, map: "appraisals_enquiry_fkey")
  assignedMembership       Membership          @relation("AppraisalAssigned", fields: [workspaceId, assignedMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "appraisals_assigned_fkey")
  createdByMembership      Membership          @relation("AppraisalCreatedBy", fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "appraisals_created_by_fkey")
  tasks                    EnquiryTask[]
  instructions             Instruction[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, enquiryId, id], map: "appraisals_workspace_enquiry_id_key")
  @@index([workspaceId, enquiryId, scheduledAt], map: "appraisals_enquiry_idx")
  @@index([workspaceId, assignedMembershipId, status, scheduledAt], map: "appraisals_assigned_idx")
  @@index([workspaceId, createdByMembershipId], map: "appraisals_creator_idx")
  @@map("appraisals")
}

model EnquiryTask {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId           String            @map("workspace_id") @db.Uuid
  enquiryId             String            @map("enquiry_id") @db.Uuid
  appraisalId           String?           @map("appraisal_id") @db.Uuid
  title                 String            @db.VarChar(200)
  dueOn                 DateTime          @map("due_on") @db.Date
  plannedFor            DateTime?         @map("planned_for") @db.Timestamptz(6)
  assignedMembershipId  String            @map("assigned_membership_id") @db.Uuid
  status                EnquiryTaskStatus @default(OPEN)
  closedAt              DateTime?         @map("closed_at") @db.Timestamptz(6)
  closedByMembershipId  String?           @map("closed_by_membership_id") @db.Uuid
  createdByMembershipId String            @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  enquiry               Enquiry           @relation(fields: [workspaceId, enquiryId], references: [workspaceId, id], onDelete: Restrict, map: "enquiry_tasks_enquiry_fkey")
  appraisal             Appraisal?        @relation(fields: [workspaceId, enquiryId, appraisalId], references: [workspaceId, enquiryId, id], onDelete: Restrict, map: "enquiry_tasks_appraisal_fkey")
  assignedMembership    Membership        @relation("EnquiryTaskAssigned", fields: [workspaceId, assignedMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "enquiry_tasks_assigned_fkey")
  closedByMembership    Membership?       @relation("EnquiryTaskClosedBy", fields: [workspaceId, closedByMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "enquiry_tasks_closed_by_fkey")
  createdByMembership   Membership        @relation("EnquiryTaskCreatedBy", fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "enquiry_tasks_created_by_fkey")

  @@unique([workspaceId, id])
  @@index([workspaceId, enquiryId, status, dueOn], map: "enquiry_tasks_enquiry_idx")
  @@index([workspaceId, assignedMembershipId, status, dueOn], map: "enquiry_tasks_assigned_idx")
  @@index([workspaceId, enquiryId, appraisalId], map: "enquiry_tasks_appraisal_idx")
  @@index([workspaceId, closedByMembershipId], map: "enquiry_tasks_closed_by_idx")
  @@index([workspaceId, createdByMembershipId], map: "enquiry_tasks_creator_idx")
  @@map("enquiry_tasks")
}

// A general action (to-do) not tied to a landlord lead. Lead next actions stay
// in enquiry_tasks; the dashboard shows both in one list.
model Action {
  id                       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId              String       @map("workspace_id") @db.Uuid
  responsibleBranchId      String       @map("responsible_branch_id") @db.Uuid
  title                    String       @db.VarChar(200)
  kind                     ActionKind   @default(OTHER)
  dueOn                    DateTime     @map("due_on") @db.Date
  plannedFor               DateTime?    @map("planned_for") @db.Timestamptz(6)
  assignedMembershipId     String       @map("assigned_membership_id") @db.Uuid
  contactId                String?      @map("contact_id") @db.Uuid
  propertyId               String?      @map("property_id") @db.Uuid
  applicantId              String?      @map("applicant_id") @db.Uuid
  propertyEnquiryId        String?      @map("property_enquiry_id") @db.Uuid
  status                   ActionStatus @default(OPEN)
  // Set by a database trigger when the action is closed.
  closedAt                 DateTime?    @map("closed_at") @db.Timestamptz(6)
  closedByMembershipId     String?      @map("closed_by_membership_id") @db.Uuid
  // Set by a database trigger to whoever last changed the assignee.
  handedOverByMembershipId String?      @map("handed_over_by_membership_id") @db.Uuid
  createdByMembershipId    String       @map("created_by_membership_id") @db.Uuid
  createdAt                DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace                Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  responsibleBranch        Branch       @relation(fields: [workspaceId, responsibleBranchId], references: [workspaceId, id], onDelete: Restrict, map: "actions_branch_fkey")
  assignedMembership       Membership   @relation("ActionAssigned", fields: [workspaceId, assignedMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "actions_assigned_fkey")
  contact                  Contact?     @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Restrict, map: "actions_contact_fkey")
  property                 Property?    @relation(fields: [workspaceId, propertyId], references: [workspaceId, id], onDelete: Restrict, map: "actions_property_fkey")
  closedByMembership       Membership?  @relation("ActionClosedBy", fields: [workspaceId, closedByMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "actions_closed_by_fkey")
  handedOverByMembership   Membership?  @relation("ActionHandedOverBy", fields: [workspaceId, handedOverByMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "actions_handed_over_by_fkey")
  createdByMembership      Membership   @relation("ActionCreatedBy", fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "actions_created_by_fkey")

  applicant       Applicant?       @relation(fields: [workspaceId, applicantId], references: [workspaceId, id], onDelete: Restrict, map: "actions_applicant_fkey")
  propertyEnquiry PropertyEnquiry? @relation(fields: [workspaceId, propertyEnquiryId], references: [workspaceId, id], onDelete: Restrict, map: "actions_property_enquiry_fkey")

  @@unique([workspaceId, id])
  @@index([workspaceId, assignedMembershipId, status, dueOn], map: "actions_assigned_idx")
  @@index([workspaceId, responsibleBranchId, status, dueOn], map: "actions_branch_idx")
  @@index([workspaceId, createdByMembershipId], map: "actions_creator_idx")
  @@index([workspaceId, contactId], map: "actions_contact_idx")
  @@index([workspaceId, propertyId], map: "actions_property_idx")
  @@index([workspaceId, handedOverByMembershipId], map: "actions_handed_over_by_idx")
  @@index([workspaceId, closedByMembershipId], map: "actions_closed_by_idx")
  @@index([workspaceId, applicantId], map: "actions_applicant_idx")
  @@index([workspaceId, propertyEnquiryId], map: "actions_property_enquiry_idx")
  @@map("actions")
}

// Chunk 6A. An instruction is created from a won landlord lead and covers one
// property; Current until it records an ended date. One current instruction
// per property, enforced by the database. Its records below are history: the
// database adds rows, never edits them (landlords are only removed), and the
// app role cannot delete.
model Instruction {
  id                    String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId           String                      @map("workspace_id") @db.Uuid
  reference             String                      @db.VarChar(20)
  propertyId            String                      @map("property_id") @db.Uuid
  enquiryId             String                      @map("enquiry_id") @db.Uuid
  appraisalId           String?                     @map("appraisal_id") @db.Uuid
  responsibleBranchId   String                      @map("responsible_branch_id") @db.Uuid
  leadMembershipId      String?                     @map("lead_membership_id") @db.Uuid
  instructedOn          DateTime                    @map("instructed_on") @db.Date
  journeyStage          InstructionJourneyStage     @default(ONBOARDING) @map("journey_stage")
  // Set by a database trigger whenever the journey stage changes.
  journeyChangedAt      DateTime                    @default(now()) @map("journey_changed_at") @db.Timestamptz(6)
  endedOn               DateTime?                   @map("ended_on") @db.Date
  endedReason           String?                     @map("ended_reason") @db.VarChar(500)
  // Set by a database trigger when the instruction is ended.
  endedAt               DateTime?                   @map("ended_at") @db.Timestamptz(6)
  endedByMembershipId   String?                     @map("ended_by_membership_id") @db.Uuid
  createdByMembershipId String                      @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace             Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  property              Property                    @relation(fields: [workspaceId, propertyId], references: [workspaceId, id], onDelete: Restrict, map: "instructions_property_fkey")
  enquiry               Enquiry                     @relation(fields: [workspaceId, enquiryId], references: [workspaceId, id], onDelete: Restrict, map: "instructions_enquiry_fkey")
  appraisal             Appraisal?                  @relation(fields: [workspaceId, enquiryId, appraisalId], references: [workspaceId, enquiryId, id], onDelete: Restrict, map: "instructions_appraisal_fkey")
  responsibleBranch     Branch                      @relation(fields: [workspaceId, responsibleBranchId], references: [workspaceId, id], onDelete: Restrict, map: "instructions_branch_fkey")
  leadMembership        Membership?                 @relation("InstructionLead", fields: [workspaceId, leadMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "instructions_lead_membership_fkey")
  endedByMembership     Membership?                 @relation("InstructionEndedBy", fields: [workspaceId, endedByMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "instructions_ended_by_fkey")
  createdByMembership   Membership                  @relation("InstructionCreatedBy", fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "instructions_created_by_fkey")
  journeyHistory        InstructionJourneyHistory[]
  parties               InstructionParty[]
  termsVersions         InstructionTermsVersion[]
  agreementEvents       InstructionAgreementEvent[]
  ownershipChecks       InstructionOwnershipCheck[]
  exceptions            InstructionException[]
  documents             Document[]
  agreements            InstructionAgreement[]

  listings Listing[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, reference])
  @@unique([workspaceId, enquiryId])
  @@index([workspaceId, propertyId, instructedOn], map: "instructions_property_idx")
  @@index([workspaceId, responsibleBranchId, journeyStage], map: "instructions_branch_idx")
  @@index([workspaceId, enquiryId, appraisalId], map: "instructions_appraisal_idx")
  @@index([workspaceId, leadMembershipId], map: "instructions_lead_membership_idx")
  @@index([workspaceId, endedByMembershipId], map: "instructions_ended_by_idx")
  @@index([workspaceId, createdByMembershipId], map: "instructions_creator_idx")
  @@map("instructions")
}

model InstructionJourneyHistory {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId           String                  @map("workspace_id") @db.Uuid
  instructionId         String                  @map("instruction_id") @db.Uuid
  fromStage             InstructionJourneyStage @map("from_stage")
  toStage               InstructionJourneyStage @map("to_stage")
  reason                String?                 @db.VarChar(500)
  changedByMembershipId String                  @map("changed_by_membership_id") @db.Uuid
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  instruction           Instruction             @relation(fields: [workspaceId, instructionId], references: [workspaceId, id], onDelete: Restrict, map: "instruction_journey_history_instruction_fkey")
  changedByMembership   Membership              @relation("InstructionJourneyChangedBy", fields: [workspaceId, changedByMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "instruction_journey_history_actor_fkey")

  @@unique([workspaceId, id])
  @@unique([workspaceId, instructionId, createdAt], map: "instruction_journey_history_one_per_transaction")
  @@index([workspaceId, changedByMembershipId], map: "instruction_journey_history_actor_idx")
  @@map("instruction_journey_history")
}

// One current main contact per instruction (a partial unique index in the
// migration). Removing a landlord keeps the row.
model InstructionParty {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId           String      @map("workspace_id") @db.Uuid
  instructionId         String      @map("instruction_id") @db.Uuid
  contactId             String      @map("contact_id") @db.Uuid
  isMainContact         Boolean     @default(false) @map("is_main_contact")
  addedByMembershipId   String      @map("added_by_membership_id") @db.Uuid
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  // Set by a database trigger when the removal reason is recorded.
  removedAt             DateTime?   @map("removed_at") @db.Timestamptz(6)
  removedByMembershipId String?     @map("removed_by_membership_id") @db.Uuid
  removedReason         String?     @map("removed_reason") @db.VarChar(500)
  updatedAt             DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  instruction           Instruction @relation(fields: [workspaceId, instructionId], references: [workspaceId, id], onDelete: Restrict, map: "instruction_parties_instruction_fkey")
  contact               Contact     @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Restrict, map: "instruction_parties_contact_fkey")
  addedByMembership     Membership  @relation("InstructionPartyAddedBy", fields: [workspaceId, addedByMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "instruction_parties_added_by_fkey")
  removedByMembership   Membership? @relation("InstructionPartyRemovedBy", fields: [workspaceId, removedByMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "instruction_parties_removed_by_fkey")

  @@unique([workspaceId, id])
  @@index([workspaceId, contactId, removedAt], map: "instruction_parties_contact_idx")
  @@index([workspaceId, addedByMembershipId], map: "instruction_parties_added_by_idx")
  @@index([workspaceId, removedByMembershipId], map: "instruction_parties_removed_by_idx")
  @@map("instruction_parties")
}

// A whole, immutable set of terms. The current terms are the latest version.
model InstructionTermsVersion {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId           String                   @map("workspace_id") @db.Uuid
  instructionId         String                   @map("instruction_id") @db.Uuid
  service               LettingServiceType
  askingRentPence       Int?                     @map("asking_rent_pence")
  rentPeriod            RentPeriod?              @map("rent_period")
  feeKind               FeeKind?                 @map("fee_kind")
  // Basis points for a percentage fee (1250 = 12.5%); pence for a fixed fee.
  feeValue              Int?                     @map("fee_value")
  feeFrequency          FeeFrequency?            @map("fee_frequency")
  feeVat                FeeVatTreatment?         @map("fee_vat")
  depositOffering       DepositOffering?         @map("deposit_offering")
  depositPence          Int?                     @map("deposit_pence")
  holdingDepositPence   Int?                     @map("holding_deposit_pence")
  // Required for every version after the first.
  changeReason          String?                  @map("change_reason") @db.VarChar(500)
  createdByMembershipId String                   @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  instruction           Instruction              @relation(fields: [workspaceId, instructionId], references: [workspaceId, id], onDelete: Restrict, map: "instruction_terms_versions_instruction_fkey")
  createdByMembership   Membership               @relation("InstructionTermsCreatedBy", fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: Restrict, map: "instruction_terms_versions_created_by_fkey")
  charges               InstructionTermsCharge[]
  agreements            InstructionAgreement[]

  listingVersions ListingContentVersion[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, instructionId, createdAt], map: "instruction_terms_versions_one_per_transaction")
  @@index([workspaceId, createdByMembershipId], map: "instruction_terms_versions_created_by_idx")
  @@map("instruction_terms_versions")
}

model InstructionTermsCharge {
